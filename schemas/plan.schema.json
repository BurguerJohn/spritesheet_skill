{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BurguerJohn/spritesheet_skill/schemas/plan.schema.json",
  "title": "Spritesheet planning input",
  "type": "object",
  "required": ["subject", "actions"],
  "properties": {
    "subject": {"type": "string", "minLength": 1},
    "style": {"type": "string"},
    "background": {"type": "string"},
    "canvas": {
      "description": "ImageGen-native generation canvas. Omit or use mode:auto to choose automatically.",
      "oneOf": [
        {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"const": "auto"}},
          "additionalProperties": false
        },
        {
          "enum": [
            {"width": 1024, "height": 1024},
            {"width": 1536, "height": 1024},
            {"width": 1024, "height": 1536}
          ]
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "frames"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "loop": {"type": "boolean"},
          "duration_ms": {"type": "integer", "minimum": 1},
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["description"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 1},
                "duration_ms": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
